+#pragma once
+
+#include <cstdint>
+#include <memory>
+
+#include "envoy/buffer/buffer.h"
+#include "envoy/common/pure.h"
+#include "envoy/stream_info/filter_state.h"
+
+#include "absl/functional/any_invocable.h"
+#include "absl/status/statusor.h"
+#include "absl/strings/string_view.h"
+
+namespace Envoy {
+namespace Http {
+
+/**
+ * The request body a decoder filter has passed on toward the router, kept so that the router can
+ * replay retries from it instead of buffering a copy of its own. A filter that holds the whole
+ * body anyway, in memory or in an external store, publishes one in the stream's filter state
+ * under key() before it passes the first body byte on.
+ *
+ * Filters between the publisher and the router may change the body, so the router does not take
+ * this on trust: it fingerprints what it receives and uses the object only if crc32c() and
+ * length() match once both sides have seen the whole body.
+ */
+class ReplayableRequestBody : public StreamInfo::FilterState::Object {
+public:
+  // Delivers between 1 and the requested number of bytes, or an error. An error is final: the
+  // body can no longer be replayed.
+  using ReadCallback = absl::AnyInvocable<void(absl::StatusOr<Buffer::InstancePtr>)>;
+
+  // Destroying a handle cancels its read; the callback does not run afterwards.
+  class ReadHandle {
+  public:
+    virtual ~ReadHandle() = default;
+  };
+  using ReadHandlePtr = std::unique_ptr<ReadHandle>;
+
+  static constexpr absl::string_view key() { return "envoy.http.replayable_request_body"; }
+
+  /**
+   * @return the number of bytes passed on so far.
+   */
+  virtual uint64_t length() const PURE;
+
+  /**
+   * @return whether every byte of the body has been passed on.
+   */
+  virtual bool complete() const PURE;
+
+  /**
+   * @return the CRC32C of the bytes passed on so far.
+   */
+  virtual uint32_t crc32c() const PURE;
+
+  /**
+   * Reads bytes starting at `offset`, which must be below length(). The callback may run before
+   * read() returns, in which case the returned handle is null.
+   */
+  virtual ReadHandlePtr read(uint64_t offset, uint64_t max_length, ReadCallback cb) const PURE;
+};
+
+} // namespace Http
+} // namespace Envoy
