+  replay_cb_->invokeCallback();
+  ASSERT_TRUE(replay_done_);
+  EXPECT_EQ(posting_factory_.create_calls_, 0);
+
+  EXPECT_EQ(readOneEmitted(*this, *manager_, 2, 8), "contents");
+}
+
+// A read from an asynchronous store completes later; destroying its handle first cancels it.
+TEST_F(BufferManagerTest, EmissionRecordAsyncReadIsCancelledWithItsHandle) {
+  resetManager(posting_factory_);
+  manager_->recordEmission();
+  Buffer::OwnedImpl body("0123456789");
+  manager_->onData(body);
+  manager_->endStream();
+  drain();
+  replayAll();
+  replay_cb_->invokeCallback();
+  drain();
+  ASSERT_TRUE(replay_done_);
+
+  bool called = false;
+  auto cancelled = manager_->readEmitted(
+      0, 4, [&called](absl::StatusOr<Buffer::InstancePtr>) { called = true; });
+  ASSERT_NE(cancelled, nullptr);
+  cancelled.reset();
+  drain();
+  EXPECT_FALSE(called);
+
+  std::string out;
+  auto handle = manager_->readEmitted(3, 4, [&out](absl::StatusOr<Buffer::InstancePtr> data) {
+    ASSERT_OK(data.status());
+    out = (*data)->toString();
+  });
+  ASSERT_NE(handle, nullptr);
+  drain();
+  EXPECT_EQ(out, "3456");
+}
+
+// Once detached the record is gone with the store.
+TEST_F(BufferManagerTest, EmissionRecordIsUnreadableAfterDestroy) {
+  manager_->recordEmission();
+  Buffer::OwnedImpl body("0123456789");
+  manager_->onData(body);
+  manager_->endStream();
+  drain();
+  replayAll();
+  replay_cb_->invokeCallback();
+  drain();
+  ASSERT_TRUE(replay_done_);
+  manager_->onDestroy();
+
+  bool failed = false;
+  manager_->readEmitted(
+      0, 1, [&failed](absl::StatusOr<Buffer::InstancePtr> data) { failed = !data.ok(); });
+  EXPECT_TRUE(failed);
+}
