+namespace {
+
+struct EmittedRead {
+  Http::ReplayableRequestBody::ReadCallback cb;
+  bool live{true};
+  bool done{false};
+};
+
+class EmittedReadHandle : public Http::ReplayableRequestBody::ReadHandle {
+public:
+  explicit EmittedReadHandle(std::shared_ptr<EmittedRead> read) : read_(std::move(read)) {}
+  ~EmittedReadHandle() override { read_->live = false; }
+
+private:
+  std::shared_ptr<EmittedRead> read_;
+};
+
+} // namespace
+
+Http::ReplayableRequestBody::ReadHandlePtr
+BufferManager::readEmitted(uint64_t offset, uint64_t max_length,
+                           Http::ReplayableRequestBody::ReadCallback cb) {
+  if (destroyed_ || offset >= emitted_length_ || max_length == 0) {
+    cb(absl::FailedPreconditionError("emitted body is not readable at this offset"));
+    return nullptr;
+  }
+  auto span = std::upper_bound(
+      emitted_spans_.begin(), emitted_spans_.end(), offset,
+      [](uint64_t value, const EmittedSpan& s) { return value < s.emitted_offset; });
+  ASSERT(span != emitted_spans_.begin());
+  --span;
+  const uint64_t within = offset - span->emitted_offset;
+  const uint64_t length = std::min(max_length, span->length - within);
+  const uint64_t source_offset = span->source_offset + within;
+
+  if (!span->from_store || buffer_ == nullptr) {
+    // Inline bytes and the in-memory tier are both resident, so the read completes here.
+    const Buffer::Instance& source = span->from_store ? pending_ : emitted_inline_;
+    auto bytes = std::make_unique<uint8_t[]>(length);
+    source.copyOut(source_offset, length, bytes.get());
+    auto data = std::make_unique<Buffer::OwnedImpl>(bytes.get(), length);
+    cb(std::move(data));
+    return nullptr;
+  }
+
+  auto read = std::make_shared<EmittedRead>();
+  read->cb = std::move(cb);
+  buffer_->read(source_offset, length,
+                [read](ExternalBufferStatus status, Buffer::InstancePtr data) {
+                  if (!read->live) {
+                    return;
+                  }
+                  read->done = true;
+                  if (status != ExternalBufferStatus::Ok) {
+                    read->cb(absl::UnavailableError("external buffer read failed"));
+                    return;
+                  }
+                  read->cb(std::move(data));
+                });
+  if (read->done) {
+    return nullptr;
+  }
+  return std::make_unique<EmittedReadHandle>(std::move(read));
+}
