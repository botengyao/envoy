+void BufferManager::recordEmitted(const Buffer::Instance& data,
+                                  std::optional<uint64_t> store_offset) {
+  if (!record_emission_ || data.length() == 0) {
+    return;
+  }
+  for (const Buffer::RawSlice& slice : data.getRawSlices()) {
+    emitted_crc_ = absl::ExtendCrc32c(
+        emitted_crc_, absl::string_view(static_cast<const char*>(slice.mem_), slice.len_));
+  }
+  const bool from_store = store_offset.has_value();
+  const uint64_t source_offset = from_store ? *store_offset : emitted_inline_.length();
+  if (!from_store) {
+    emitted_inline_.add(data);
+  }
+  if (!emitted_spans_.empty()) {
+    EmittedSpan& last = emitted_spans_.back();
+    if (last.from_store == from_store && last.source_offset + last.length == source_offset) {
+      last.length += data.length();
+      emitted_length_ += data.length();
+      return;
+    }
+  }
+  emitted_spans_.push_back({emitted_length_, data.length(), source_offset, from_store});
+  emitted_length_ += data.length();
+}
